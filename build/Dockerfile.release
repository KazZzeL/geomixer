# syntax=docker/dockerfile:1
FROM alpine:3.24.4@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf AS runtime

RUN set -eux \
  && addgroup \
      --gid 1000 \
      app \
  && adduser \
      --uid 1000 \
      --ingroup app \
      --shell /bin/sh \
      --disabled-password \
      --no-create-home \
      app \
  && apk add --no-cache \
      ca-certificates=20261020-r0 \
      tzdata=2026f-r0 \
  && update-ca-certificates

ARG TARGETPLATFORM

WORKDIR /app

COPY --chown=app:app $TARGETPLATFORM/geomixer /usr/local/bin/geomixer

USER 1000:1000

CMD [ "geomixer" ]
STOPSIGNAL SIGTERM
