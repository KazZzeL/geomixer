# syntax=docker/dockerfile:1
FROM alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

RUN set -eux \
  && addgroup \
      --gid 1000 \
      app \
  && adduser \
      --uid 1000 \
      --ingroup app \
      --shell /bin/sh \
      --disabled-password \
      --no-create-home \
      app \
  && apk add --no-cache \
      ca-certificates=20260611-r0 \
      tzdata=2026c-r0 \
  && update-ca-certificates

WORKDIR /app

ARG TARGETPLATFORM

COPY --chown=app:app $TARGETPLATFORM/geomixer /usr/local/bin/geomixer

USER 1000:1000

CMD [ "geomixer" ]
STOPSIGNAL SIGTERM
