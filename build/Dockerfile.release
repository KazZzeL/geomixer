# syntax=docker/dockerfile:1
FROM alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a AS runtime

RUN set -eux \
  && addgroup \
      --gid 1000 \
      app \
  && adduser \
      --uid 1000 \
      --ingroup app \
      --shell /bin/sh \
      --disabled-password \
      --no-create-home \
      app \
  && apk add --no-cache \
      ca-certificates=20261020-r0 \
      tzdata=2026e-r0 \
  && update-ca-certificates

ARG TARGETPLATFORM

WORKDIR /app

COPY --chown=app:app $TARGETPLATFORM/geomixer /usr/local/bin/geomixer

USER 1000:1000

CMD [ "geomixer" ]
STOPSIGNAL SIGTERM
